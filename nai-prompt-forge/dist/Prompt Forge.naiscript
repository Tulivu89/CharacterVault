            h(Btn, { onClick: () => renderLive().then(() => toast('Blocks written to the document.', 'success')) }, "Write to document"),
            h(Btn, { onClick: saveSetup }, "Save setup")),
        h(CopyBlock, { title: "Model & Settings", text: b.settings, what: "the settings" }),
        h(CopyBlock, { title: "Base Prompt", text: b.base, what: "the base prompt" }),
        h(CopyBlock, { title: "Base UC", text: b.baseUc, what: "the base UC" }),
        b.chars.map((c, i) => (h("div", { style: { ...st.card, ...st.col } },
            h(CopyBlock, { title: c.title, text: c.prompt, what: `character ${i + 1}` }),
            h(CopyBlock, { title: `Character ${i + 1} UC`, text: c.uc, what: `character ${i + 1} UC` })))),
        b.notes.length ? (h(Panel, { title: "Notes", startOpen: false }, b.notes.map(n => (h("span", { style: st.hint },
            "\u2022 ",
