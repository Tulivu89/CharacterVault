    pre: { whiteSpace: 'pre-wrap', wordBreak: 'break-word', background: C.bg0, border: `1px solid ${C.bg3}`, borderRadius: '4px', padding: '6px 8px', margin: 0, fontFamily: 'var(--theme-font-code, monospace)', fontSize: '12px', maxHeight: '260px', overflow: 'auto' },
    tab: (on) => ({ padding: '5px 10px', borderRadius: '4px 4px 0 0', border: `1px solid ${on ? C.bg3 : 'transparent'}`, borderBottom: 'none', background: on ? C.bg1 : 'transparent', color: on ? C.head : C.dim, cursor: 'pointer', font: 'inherit' }),
    btn: (kind = 'ghost', disabled = false) => ({
