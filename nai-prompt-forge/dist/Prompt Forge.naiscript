                h(Field, { label: "Label in prose", hint: "tall fox girl, girl in yellow jacket" },
                    h(TextIn, { value: sheet.label, onChange: v => ed(x => (x.label = v)) })),
                h(Field, { label: "Box starts with" },
                    h(Pick, { value: sheet.gender, options: ['girl', 'boy', 'other'], onChange: v => ed(x => (x.gender = v)) }))),
            h(Panel, { title: "Build from a description" },
                h(Area, { value: desc, rows: 3, onChange: setDesc, placeholder: "Plain words: species, build, hair, eyes, marks, clothes. The model picks real tags from menus, one part at a time." }),
                h("div", { style: st.row },
                    h(StepBtn, { job: "look", arg: { sheetId: sheet.id, group: 'head', description: desc }, label: "Head and face", s: s }),
                    h(StepBtn, { job: "look", arg: { sheetId: sheet.id, group: 'body', description: desc }, label: "Body", s: s }),
                    h(StepBtn, { job: "outfit", arg: { sheetId: sheet.id, description: desc }, label: "Outfit", s: s }))),
            h(Panel, { title: "Look (character standard, head to toe)" },
                h("div", { style: st.row },
                    h("span", { style: { flex: '1 1 200px' } },
                        h(Pick, { value: kit, options: [['', 'add a face or body kit…'], ...s.lib.kits.map(k => [k.id, k.name])], onChange: setKit })),
                    kit ? (h(Btn, { onClick: () => {
                            const k = s.lib.kits.find(y => y.id === kit);
                            if (k)
