    if (feel.length)
        issue(ctx, 'info', where, `"${uniq(feel).join('", "')}": inner life doesn't render; show it in face and body.`);
    if (words.some(w => ['then', 'afterwards', 'later', 'finally'].includes(w)))
        issue(ctx, 'info', where, 'Time-sequence words: an image is one frozen instant.');
    if (words.some(w => ['smell', 'smells', 'scent', 'sound', 'sounds', 'hear', 'hears', 'noise', 'taste', 'tastes'].includes(w)))
