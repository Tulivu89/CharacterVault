    const mine = lib.examples
        .filter(e => e.job === job)
        .map(e => ({ e, score: e.tags.filter(t => tags.includes(t)).length }))
        .sort((a, b) => b.score - a.score)
        .slice(0, 2)
        .map(x => ({ input: x.e.input, output: x.e.output }));
