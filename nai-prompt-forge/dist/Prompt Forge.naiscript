function newSheetFromCast(c) {
    const sh = { ...blankSheet(), name: c.label || 'New character', label: c.label || c.gender, gender: c.gender };
    STORE.set(s => ({
        ...s,
        lib: { ...s.lib, sheets: [...s.lib.sheets, sh] },
        sheetId: sh.id,
        tab: 'looks',
        setup: { ...s.setup, cast: s.setup.cast.map(m => (m.id === c.id ? { ...m, sheetId: sh.id } : m)) },
    }));
}
function Interactions(p) {
    const x = p.s.setup;
    const who = x.cast.map(c => [c.id, c.label || c.gender]);
    return (h("div", { style: st.col },
        h("div", { style: { ...st.row, justifyContent: 'space-between' } },
            h("span", { style: st.label }, "Interactions (source# / target# / mutual#)"),
            h(Btn, { onClick: () => editSetup(d => d.interactions.push({ id: shortId(), actor: d.cast[0].id, act: '', target: d.cast[1]?.id || '', mutual: false })) }, "+ interaction")),
        x.interactions.map(it => {
            const ed = (fn) => editSetup(d => {
                const t = d.interactions.find(y => y.id === it.id);
                if (t)
                    fn(t);
            });
            return (h("div", { style: st.row },
                h("span", { style: { width: '150px' } },
                    h(Pick, { value: it.actor, options: who, onChange: v => ed(t => (t.actor = v)) })),
                h("span", { style: { width: '140px' } },
                    h(TextIn, { value: it.act, placeholder: "headpat, hug, kiss\u2026", onChange: v => ed(t => (t.act = v)) })),
                h("span", { style: { width: '150px' } },
                    h(Pick, { value: it.target, options: [['', 'nobody in frame'], ...who], onChange: v => ed(t => (t.target = v)) })),
                h(Check, { checked: it.mutual, onChange: v => ed(t => (t.mutual = v)), label: "mutual" }),
                h(Btn, { kind: "danger", onClick: () => editSetup(d => (d.interactions = d.interactions.filter(y => y.id !== it.id))) }, "\u2715")));
        })));
}
function OutputTab(p) {
