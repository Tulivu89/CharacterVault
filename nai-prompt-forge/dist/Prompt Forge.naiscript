    return (h("span", { style: st.row },
        p.s.lib.sheets.length ? (h("span", { style: { width: '160px' } },
            h(Pick, { value: pick, options: [['', 'saved look…'], ...p.s.lib.sheets.map(sh => [sh.id, sh.name])], onChange: v => setPick(v) }))) : null,
        pick ? h(Btn, { onClick: () => (add(p.s.lib.sheets.find(sh => sh.id === pick) || null), setPick('')) }, "Add") : null,
        h(Btn, { onClick: () => add(null, 'girl') }, "+ girl"),
        h(Btn, { onClick: () => add(null, 'boy') }, "+ boy"),
        h(Btn, { onClick: () => add(null, 'other') }, "+ other")));
}
function CastCard(p) {
    const { s, c, i } = p;
    const sheet = s.lib.sheets.find(sh => sh.id === c.sheetId);
    const ed = (fn, undo) => editSetup(d => {
        const m = d.cast.find(y => y.id === c.id);
        if (m)
            fn(m);
    }, undo);
    const loadSheet = (id) => {
        const sh = s.lib.sheets.find(y => y.id === id) || null;
