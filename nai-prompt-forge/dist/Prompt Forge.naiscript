                h(Field, { label: "Extra UC", hint: "Only what you've watched go wrong" },
                    h(TextIn, { value: x.ucExtra, onChange: v => editSetup(d => (d.ucExtra = v)) })),
                h(Field, { label: "Extra base tags" },
                    h(TextIn, { value: x.baseExtra, onChange: v => editSetup(d => (d.baseExtra = v)) })),
                h(Field, { label: "Complexity" },
