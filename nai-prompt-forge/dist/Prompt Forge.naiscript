function sections(text) {
    const list = [];
    let head = '';
    let cur = null;
    for (const line of String(text || '').split('\n')) {
        const m = line.match(/^\s*\[([a-z][a-z0-9 -]*?)(?:\s*:\s*(.*?))?\]\s*$/i);
        if (m) {
            cur = { name: m[1].trim().toLowerCase(), arg: (m[2] || '').trim(), body: '' };
            list.push(cur);
            continue;
        }
        if (cur)
            cur.body += (cur.body ? '\n' : '') + line;
        else
            head += (head ? '\n' : '') + line;
    }
    for (const s of list)
        s.body = s.body.trim();
    return { head: head.trim(), list };
}
function keyLines(body, keys) {
    const out = {};
    const lower = keys.map(k => k.toLowerCase());
    for (const line of body.split('\n')) {
        const m = line.match(/^\s*([A-Za-z][A-Za-z ]{0,24}?)\s*:\s?(.*)$/);
        if (!m)
            continue;
        const i = lower.indexOf(m[1].trim().toLowerCase());
        if (i >= 0)
            out[keys[i]] = out[keys[i]] ? out[keys[i]] + '\n' + m[2].trim() : m[2].trim();
    }
    return out;
}
const LOOK_KEYS = LOOK_SLOTS.map(s => s.key);
const OUTFIT_KEYS_ALL = OUTFIT_SLOTS.map(s => s.key);
function sheetToText(s) {
    const out = [`id: ${s.id}`, `gender: ${s.gender}`, `label: ${s.label}`, '', '[look]'];
    for (const k of LOOK_KEYS) {
        for (const l of lines(s.look[k]))
            out.push(`${k}: ${l}`);
    }
    for (const o of s.outfits) {
        out.push('', `[outfit: ${o.name}]`);
        for (const k of OUTFIT_KEYS_ALL)
            for (const l of lines(o.lines[k]))
                out.push(`${k}: ${l}`);
        if (o.uc.trim())
            out.push(`uc: ${o.uc.trim()}`);
    }
    out.push('', '[uc]', s.uc.trim());
    if (s.explicit.trim())
        out.push('', '[explicit]', s.explicit.trim());
    return out.join('\n').trim();
}
function sheetFromText(name, text, id) {
    const { head, list } = sections(text);
    const h = keyLines(head, ['id', 'gender', 'label']);
    const g = (h.gender || 'girl').toLowerCase();
    const sheet = {
        id: h.id || id || shortId(),
        name,
        label: h.label || g,
        gender: g === 'boy' ? 'boy' : g === 'other' ? 'other' : 'girl',
        look: {},
        outfits: [],
        uc: '',
        explicit: '',
    };
    for (const sec of list) {
        if (sec.name === 'look')
            sheet.look = keyLines(sec.body, LOOK_KEYS);
        else if (sec.name === 'outfit') {
            const f = keyLines(sec.body, [...OUTFIT_KEYS_ALL, 'uc']);
            const { uc, ...rest } = f;
            sheet.outfits.push({ name: sec.arg || `Outfit ${sheet.outfits.length + 1}`, lines: rest, uc: uc || '' });
        }
        else if (sec.name === 'uc')
            sheet.uc = sec.body;
        else if (sec.name === 'explicit')
            sheet.explicit = sec.body;
    }
    if (!sheet.outfits.length)
        sheet.outfits.push({ name: 'Default', lines: {}, uc: '' });
    return sheet;
}
function styleToText(s) {
    const out = [`id: ${s.id}`, `own tail: ${s.ownTail ? 'yes' : 'no'}`];
    if (s.guidance)
        out.push(`guidance: ${s.guidance}`);
    if (s.note)
        out.push(`note: ${s.note}`);
    out.push('', '[base]', s.base, '', '[uc]', s.uc);
    for (const a of s.addons) {
        out.push('', `[addon: ${a.name}]`, a.text);
        if (a.ucDrop)
            out.push(`uc drop: ${a.ucDrop}`);
    }
    return out.join('\n');
}
function styleFromText(name, text, id) {
    const { head, list } = sections(text);
    const h = keyLines(head, ['id', 'own tail', 'guidance', 'note']);
    const s = { id: h.id || id || shortId(), name, base: '', uc: '', addons: [], ownTail: /^y/i.test(h['own tail'] || ''), guidance: parseFloat(h.guidance) || undefined, note: h.note || '' };
    for (const sec of list) {
        if (sec.name === 'base')
            s.base = sec.body.replace(/\s*\n\s*/g, ' ');
        else if (sec.name === 'uc')
            s.uc = sec.body.replace(/\s*\n\s*/g, ' ');
        else if (sec.name === 'addon') {
            const drop = sec.body.match(/^\s*uc drop:\s*(.*)$/im);
            s.addons.push({ name: sec.arg || `Add-on ${s.addons.length + 1}`, text: sec.body.replace(/^\s*uc drop:.*$/gim, '').trim().replace(/\s*\n\s*/g, ' '), ucDrop: drop ? drop[1].trim() : undefined });
        }
    }
    if (!h['own tail'])
        s.ownTail = /\byear \d{4}\b/.test(s.base);
    return s;
}
function kitToText(k) {
    const out = [`id: ${k.id}`, `kind: ${k.kind}`];
    if (k.note)
        out.push(`note: ${k.note}`);
    for (const key of LOOK_KEYS) {
        const v = k.parts[key];
        if (v)
            out.push('', `[${key}]`, v);
    }
    out.push('', '[uc]', k.uc);
    return out.join('\n');
}
function kitFromText(name, text, id) {
    const { head, list } = sections(text);
    const h = keyLines(head, ['id', 'kind', 'note']);
    const k = { id: h.id || id || shortId(), name, kind: /body/i.test(h.kind || '') ? 'body' : 'face', parts: {}, uc: '', note: h.note || '' };
    for (const sec of list) {
        const key = LOOK_KEYS.find(x => x.toLowerCase() === sec.name.replace(/\s+/g, '').toLowerCase());
        if (key)
            k.parts[key] = sec.body;
        else if (sec.name === 'uc')
            k.uc = sec.body;
    }
    return k;
}
function exampleToText(e) {
    return [`job: ${e.job}`, `tags: ${e.tags.join(', ')}`, '', '[input]', e.input, '', '[output]', e.output].join('\n');
}
function exampleFromText(text, id) {
    const { head, list } = sections(text);
    const h = keyLines(head, ['job', 'tags']);
    const job = (h.job || '').trim();
    if (!(job in JOBS))
        return null;
    const input = list.find(s => s.name === 'input')?.body || '';
    const output = list.find(s => s.name === 'output')?.body || '';
    if (!input || !output)
        return null;
    return { id: id || shortId(), job, tags: (h.tags || '').split(',').map(t => t.trim()).filter(Boolean), input, output };
}
function applyKit(sheet, kit) {
    const look = { ...sheet.look };
    for (const [slot, text] of Object.entries(kit.parts)) {
        if (!text)
            continue;
        const cur = splitLine(look[slot] || '');
        const add = splitLine(text);
        const tags = uniq([...cur.tags, ...add.tags].map(t => t.trim()).filter(Boolean));
        const prose = [cur.prose, add.prose].filter(Boolean).join(' ');
        look[slot] = tagsAndProse(tags.join(', '), prose).replace(/,$/, '');
    }
    const uc = uniq([...splitSegments(sheet.uc), ...splitSegments(kit.uc)]).join(', ');
    return { ...sheet, look, uc };
}
function withBuiltins(lib) {
    const names = new Set(lib.styles.map(s => s.name.toLowerCase()));
    const kitNames = new Set(lib.kits.map(k => k.name.toLowerCase()));
    return {
        ...lib,
        styles: [...lib.styles, ...BUILTIN_STYLES.filter(s => !names.has(s.name.toLowerCase()))],
        kits: [...lib.kits, ...BUILTIN_KITS.filter(k => !kitNames.has(k.name.toLowerCase()))],
    };
}
const DEFAULT_SETTINGS = {
    mode: 'editor',
    output: 'capture',
    autoApply: true,
    retries: 1,
    sendWithNoStep: 'block',
    liveDoc: true,
    hide: [],
};
const KEYS = {
    setup: 'forge.setup',
    saved: 'forge.saved',
    settings: 'forge.settings',
    enabled: 'forge.enabled',
    doc: 'forge.doc',
    sheets: 'forge.sheets.fallback',
    fresh: 'forge.fresh',
};
function emptyLibrary() {
    return withBuiltins({ sheets: [], styles: [], kits: [], examples: [], cards: {} });
}
const STORE = createStore({
    ready: false,
    enabled: false,
    tab: 'build',
    setup: blankSetup(),
    saved: {},
    lib: emptyLibrary(),
    libSource: 'memory',
    settings: { ...DEFAULT_SETTINGS },
    run: null,
    queue: [],
    last: null,
    undo: [],
    armed: null,
    sheetId: null,
    budget: null,
});
function S() {
    return STORE.get();
}
function patch(p) {
    STORE.set(s => ({ ...s, ...p }));
}
function clone(v) {
    return JSON.parse(JSON.stringify(v));
}
function editSetup(fn, undoLabel) {
    STORE.set(st => {
        const next = clone(st.setup);
        fn(next);
        const undo = undoLabel ? [...st.undo.slice(-19), { label: undoLabel, setup: st.setup }] : st.undo;
        return { ...st, setup: next, undo };
    });
}
function editSheet(id, fn) {
    STORE.set(st => ({ ...st, lib: { ...st.lib, sheets: st.lib.sheets.map(sh => (sh.id === id ? (() => { const n = clone(sh); fn(n); return n; })() : sh)) } }));
}
function setSettings(p) {
    STORE.set(s => ({ ...s, settings: { ...s.settings, ...p } }));
}
async function toast(msg, type = 'info') {
    try {
        await api.v1.ui.toast(msg, { type, autoClose: type === 'error' ? 6000 : 3500 });
    }
    catch {
        api.v1.log(msg);
    }
}
async function ensurePerm(p, why) {
    try {
        if (await api.v1.permissions.has(p))
            return true;
        return await api.v1.permissions.request(p, why);
    }
    catch {
        return false;
    }
}
async function copyText(text, what) {
    if (!(await ensurePerm('clipboardWrite', 'Prompt Forge copies finished prompt blocks to your clipboard.')))
        return toast('Clipboard permission was not granted.', 'warning');
    await api.v1.clipboard.writeText(text);
    toast(`Copied ${what}.`, 'success');
}
let saveTimer = null;
let lastSaved = {};
async function loadState() {
    const ss = api.v1.storyStorage;
    const [setup, saved, settings, enabled] = await Promise.all([ss.get(KEYS.setup), ss.get(KEYS.saved), ss.get(KEYS.settings), ss.get(KEYS.enabled)]);
    const st = {
        setup: normalizeSetup(setup),
        saved: saved && typeof saved === 'object' ? Object.fromEntries(Object.entries(saved).map(([k, v]) => [k, normalizeSetup(v)])) : {},
        settings: { ...DEFAULT_SETTINGS, ...(settings || {}) },
        enabled: enabled === true,
        ready: true,
    };
    patch(st);
    const now = S();
    lastSaved = { setup: now.setup, saved: now.saved, settings: now.settings, enabled: now.enabled };
    STORE.subscribe(scheduleSave);
}
function scheduleSave() {
    if (saveTimer !== null)
        return;
    api.v1.timers
        .setTimeout(async () => {
        saveTimer = null;
        const s = S();
        const ss = api.v1.storyStorage;
        try {
            if (s.setup !== lastSaved.setup)
                await ss.set(KEYS.setup, s.setup);
            if (s.saved !== lastSaved.saved)
                await ss.set(KEYS.saved, s.saved);
            if (s.settings !== lastSaved.settings)
                await ss.set(KEYS.settings, s.settings);
            if (s.enabled !== lastSaved.enabled)
                await ss.set(KEYS.enabled, s.enabled);
            lastSaved = { setup: s.setup, saved: s.saved, settings: s.settings, enabled: s.enabled };
        }
        catch (e) {
            api.v1.error('Prompt Forge: save failed', e);
        }
    }, 600)
        .then(id => (saveTimer = id));
}
function undoLast() {
    const st = S();
    const step = st.undo[st.undo.length - 1];
    if (!step)
        return;
    const next = { undo: st.undo.slice(0, -1) };
    if (step.setup)
        next.setup = step.setup;
    if (step.sheet)
        next.lib = { ...st.lib, sheets: st.lib.sheets.map(sh => (sh.id === step.sheet.id ? step.sheet : sh)) };
    patch(next);
    toast(`Undid: ${step.label}`);
}
const LIB_CATS = {
    sheets: 'Forge · Characters',
    styles: 'Forge · Styles',
    kits: 'Forge · Kits',
    examples: 'Forge · Examples',
    cards: 'Forge · Cards',
};
async function libCategories(create) {
    const out = {};
    const cats = await api.v1.lorebook.categories();
    for (const key of Object.keys(LIB_CATS)) {
        const hit = cats.find(c => c.name === LIB_CATS[key]);
        if (hit)
            out[key] = hit.id;
        else if (create)
            out[key] = await api.v1.lorebook.createCategory({ id: api.v1.uuid(), name: LIB_CATS[key], enabled: false });
    }
    return out;
}
async function canEditLorebook(ask) {
    try {
        if (await api.v1.permissions.has('lorebookEdit'))
            return true;
        return ask ? await api.v1.permissions.request('lorebookEdit', 'Prompt Forge keeps characters, styles, examples and cards as Lorebook entries you can edit by hand. Its categories stay disabled, so they never enter story context.') : false;
    }
    catch {
        return false;
    }
}
async function loadLibrary() {
    const lib = { sheets: [], styles: [], kits: [], examples: [], cards: {} };
    let source = 'memory';
    try {
        const cats = await libCategories(false);
        if (Object.keys(cats).length)
            source = 'lorebook';
        if (cats.sheets)
            for (const e of await api.v1.lorebook.entries(cats.sheets))
                lib.sheets.push({ ...sheetFromText(e.displayName || 'Character', e.text || '', e.id), entryId: e.id });
        if (cats.styles)
            for (const e of await api.v1.lorebook.entries(cats.styles))
                lib.styles.push({ ...styleFromText(e.displayName || 'Style', e.text || '', e.id), entryId: e.id });
        if (cats.kits)
            for (const e of await api.v1.lorebook.entries(cats.kits))
                lib.kits.push({ ...kitFromText(e.displayName || 'Kit', e.text || '', e.id), entryId: e.id });
        if (cats.examples)
            for (const e of await api.v1.lorebook.entries(cats.examples)) {
                const ex = exampleFromText(e.text || '', e.id);
                if (ex)
                    lib.examples.push({ ...ex, entryId: e.id });
            }
        if (cats.cards)
            for (const e of await api.v1.lorebook.entries(cats.cards)) {
                const key = (e.displayName || '').replace(/^card:\s*/i, '').trim();
                if (key && e.text?.trim())
                    lib.cards[key] = e.text;
            }
    }
    catch (e) {
        api.v1.error('Prompt Forge: reading the Lorebook failed', e);
    }
    const fallback = await api.v1.storyStorage.get(KEYS.sheets);
    if (Array.isArray(fallback))
        for (const sh of fallback)
            if (!lib.sheets.some(x => x.id === sh.id))
                lib.sheets.push(sh);
    patch({ lib: withBuiltins(lib), libSource: source });
}
async function upsertEntry(cat, entryId, name, text) {
    const cats = await libCategories(true);
    if (entryId && (await api.v1.lorebook.entry(entryId))) {
        await api.v1.lorebook.updateEntry(entryId, { displayName: name, text });
        return entryId;
    }
    return api.v1.lorebook.createEntry({ id: api.v1.uuid(), displayName: name, text, category: cats[cat], keys: [], enabled: true, forceActivation: false });
}
async function saveSheet(sheet) {
    if (await canEditLorebook(true)) {
        const entryId = await upsertEntry('sheets', sheet.entryId, sheet.name, sheetToText(sheet));
        STORE.set(s => ({ ...s, lib: { ...s.lib, sheets: s.lib.sheets.map(x => (x.id === sheet.id ? { ...sheet, entryId } : x)) } }));
        toast(`Saved "${sheet.name}" to Lorebook → ${LIB_CATS.sheets}.`, 'success');
    }
    else {
        const all = S().lib.sheets.filter(x => !x.entryId);
        await api.v1.storyStorage.set(KEYS.sheets, all);
        toast(`Saved "${sheet.name}" in this story (Lorebook editing not allowed).`, 'warning');
    }
}
async function deleteSheet(sheet) {
    if (sheet.entryId && (await canEditLorebook(true)))
        await api.v1.lorebook.removeEntry(sheet.entryId);
    STORE.set(s => ({ ...s, lib: { ...s.lib, sheets: s.lib.sheets.filter(x => x.id !== sheet.id) }, sheetId: null }));
    await api.v1.storyStorage.set(KEYS.sheets, S().lib.sheets.filter(x => !x.entryId));
}
async function saveExample(ex) {
    if (!(await canEditLorebook(true)))
        return toast('Lorebook editing is needed to keep examples.', 'warning');
    const entryId = await upsertEntry('examples', ex.entryId, `${ex.job}: ${ex.tags.join(', ')}`.slice(0, 80), exampleToText(ex));
    STORE.set(s => ({ ...s, lib: { ...s.lib, examples: [...s.lib.examples.filter(x => x.id !== ex.id), { ...ex, entryId }] } }));
    toast('Kept as an example. The closest two go into future calls of this step.', 'success');
}
async function deleteExample(ex) {
    if (ex.entryId && (await canEditLorebook(true)))
        await api.v1.lorebook.removeEntry(ex.entryId);
    STORE.set(s => ({ ...s, lib: { ...s.lib, examples: s.lib.examples.filter(x => x.id !== ex.id) } }));
}
async function overrideCard(key) {
    if (!(await canEditLorebook(true)))
        return toast('Lorebook editing is needed to edit cards.', 'warning');
    const text = S().lib.cards[key] || builtinCard(key);
    await upsertEntry('cards', undefined, `Card: ${key}`, text);
    await loadLibrary();
    toast(`Card "${key}" is now in Lorebook → ${LIB_CATS.cards}. Edit it there.`, 'success');
}
async function resetCard(key) {
    if (!(await canEditLorebook(true)))
        return;
    const cats = await libCategories(false);
    if (cats.cards)
        for (const e of await api.v1.lorebook.entries(cats.cards))
            if ((e.displayName || '').replace(/^card:\s*/i, '').trim() === key)
                await api.v1.lorebook.removeEntry(e.id);
    await loadLibrary();
    toast(`Card "${key}" is back to the built-in text.`);
}
async function seedLibrary() {
    if (!(await canEditLorebook(true)))
        return toast('Lorebook editing is needed to seed the library.', 'warning');
    const cats = await libCategories(true);
    const have = new Set();
    for (const c of [cats.styles, cats.kits])
        if (c)
            for (const e of await api.v1.lorebook.entries(c))
                have.add((e.displayName || '').toLowerCase());
    let n = 0;
    for (const s of BUILTIN_STYLES)
        if (!have.has(s.name.toLowerCase()))
            (await upsertEntry('styles', undefined, s.name, styleToText(s)), n++);
    for (const k of BUILTIN_KITS)
        if (!have.has(k.name.toLowerCase()))
            (await upsertEntry('kits', undefined, k.name, kitToText(k)), n++);
    await loadLibrary();
    toast(n ? `Seeded ${n} styles and kits into the Lorebook.` : 'The Lorebook already has every built-in style and kit.', 'success');
}
async function exportLibrary() {
    if (!(await ensurePerm('fileDownload', 'Prompt Forge saves your library and setups as a JSON file.')))
        return;
    const s = S();
    const data = { forge: 1, sheets: s.lib.sheets, styles: s.lib.styles.filter(x => x.entryId), kits: s.lib.kits.filter(x => x.entryId), examples: s.lib.examples, cards: s.lib.cards, setups: s.saved };
    await api.v1.file.save('prompt-forge-library.json', JSON.stringify(data, null, 1));
}
async function importLibrary() {
    if (!(await ensurePerm('fileInput', 'Prompt Forge reads a library JSON file you pick.')))
        return;
    const text = (await api.v1.file.prompt({ accept: '.json,application/json' }));
    if (!text)
        return;
    let data;
    try {
        data = JSON.parse(text);
    }
    catch {
        return toast('That file is not JSON.', 'error');
    }
    if (!data || data.forge !== 1)
        return toast('That file is not a Prompt Forge library.', 'error');
    if (!(await canEditLorebook(true)))
        return toast('Lorebook editing is needed to import.', 'warning');
    for (const sh of data.sheets || [])
        await upsertEntry('sheets', undefined, sh.name, sheetToText(sh));
    for (const st of data.styles || [])
        await upsertEntry('styles', undefined, st.name, styleToText(st));
    for (const k of data.kits || [])
        await upsertEntry('kits', undefined, k.name, kitToText(k));
    for (const ex of data.examples || [])
        await upsertEntry('examples', undefined, `${ex.job}: ${(ex.tags || []).join(', ')}`, exampleToText(ex));
    for (const [k, v] of Object.entries(data.cards || {}))
        await upsertEntry('cards', undefined, `Card: ${k}`, String(v));
    if (data.setups)
        STORE.set(s => ({ ...s, saved: { ...s.saved, ...data.setups } }));
    await loadLibrary();
    toast('Library imported.', 'success');
}
let PENDING = null;
let ACTIVE = null;
let lastStreamPush = 0;
let pendingResult = null;
function stepLabel(job, arg, setup, lib) {
    const spec = JOBS[job];
    if (job === 'pose') {
        const c = setup.cast.find(x => x.id === arg.castId);
        return `${spec.label}: ${c?.label || 'character'}`;
    }
    if (job === 'look')
        return `${arg.group === 'body' ? 'Build body' : 'Build head and face'}: ${lib.sheets.find(s => s.id === arg.sheetId)?.name || 'character'}`;
    if (job === 'outfit')
        return `${spec.label}: ${lib.sheets.find(s => s.id === arg.sheetId)?.name || 'character'}`;
    return spec.label;
}
function setRun(p) {
    STORE.set(s => ({ ...s, run: p === null ? null : { ...s.run, ...p } }));
}
function blocker(job, arg, s) {
    if (job === 'pose' && !s.setup.cast.some(c => c.id === arg.castId))
        return 'Add a character to the cast first.';
    if ((job === 'look' || job === 'outfit') && !s.lib.sheets.some(x => x.id === arg.sheetId))
        return 'Pick or create a character first.';
    if ((job === 'look' || job === 'outfit') && !(arg.description || '').trim())
        return 'Write a description first.';
    if (job === 'prose' && !s.setup.brief.moment && !s.setup.idea)
        return 'Write an idea or plan the shot first.';
    return '';
}
function newRun(job, arg) {
    const s = S();
    const why = blocker(job, arg, s);
    if (why)
        return why;
    const { messages, allowed } = jobMessages(JOBS[job], s.setup, s.lib, arg, s.settings.hide);
    return {
        id: shortId(),
        job,
        arg,
        label: stepLabel(job, arg, s.setup, s.lib),
        base: messages,
        messages,
        allowed,
        input: messages[messages.length - 1].content || '',
        attempt: 1,
        buffer: '',
        continuityId: null,
        mode: s.settings.mode,
        cancelled: false,
        scratchFrom: null,
        savedParams: null,
        signal: null,
    };
}
async function startJob(job, arg = {}) {
    if (PENDING || ACTIVE)
        return toast('A step is already running.', 'warning');
    const run = newRun(job, arg);
    if (typeof run === 'string')
        return toast(run, 'warning');
    STORE.set(s => ({ ...s, run: { id: run.id, job, label: run.label, attempt: 1, text: '', status: 'starting', message: '', mode: run.mode }, last: null }));
    await dispatch(run);
}
async function dispatch(run) {
    if (run.mode === 'background') {
        if (budgetCovers(run))
            return runBackground(run);
        run.mode = 'editor';
        toast('The script budget is low; running this step through Send instead.', 'info');
        setRun({ mode: 'editor' });
    }
    return runEditor(run);
}
function budgetCovers(run) {
    try {
        const need = api.v1.script.countUncachedInputTokens(run.messages);
        return api.v1.script.getAllowedInput() >= need && api.v1.script.getAllowedOutput() >= JOBS[run.job].maxTokens;
    }
    catch {
        return false;
    }
}
function refreshBudget() {
    try {
        patch({ budget: { input: api.v1.script.getAllowedInput(), output: api.v1.script.getAllowedOutput() } });
    }
    catch {
    }
}
async function runEditor(run) {
    try {
        if (await api.v1.editor.isBlocked()) {
            setRun({ status: 'failed', message: 'The editor is busy. Try again in a moment.' });
            return;
        }
        const spec = JOBS[run.job];
        if (!run.savedParams && (await api.v1.permissions.has('storyEdit'))) {
            run.savedParams = await api.v1.generationParameters.get();
            await api.v1.generationParameters.update({ temperature: spec.temperature, max_tokens: spec.maxTokens });
        }
        if (S().settings.output === 'scratch' && (await ensurePerm('documentEdit', 'Prompt Forge uses a scratch paragraph for replies.'))) {
            const before = new Set(await api.v1.document.sectionIds());
            await api.v1.document.appendParagraph({ text: '' });
            run.scratchFrom = (await api.v1.document.sectionIds()).find(id => !before.has(id)) ?? null;
        }
        PENDING = run;
        setRun({ status: 'starting', attempt: run.attempt, message: '' });
        await api.v1.editor.generate();
        api.v1.timers.setTimeout(() => {
            if (PENDING === run)
                setRun({ status: 'waiting', message: 'Press Send to run this step.' });
        }, 4000);
    }
    catch (e) {
        PENDING = run;
        setRun({ status: 'waiting', message: 'Press Send to run this step.' });
    }
}
async function runBackground(run) {
    const spec = JOBS[run.job];
    try {
        const params = await api.v1.generationParameters.get();
        run.signal = await api.v1.createCancellationSignal();
        ACTIVE = run;
        setRun({ status: 'running', attempt: run.attempt, message: '' });
        const res = await api.v1.generate(run.messages, { model: params.model || 'glm-4-6', max_tokens: spec.maxTokens, temperature: spec.temperature, enable_thinking: false }, (choices, final) => {
            const c = choices[0];
            if (!c || c.isReasoning || final)
                return;
            run.buffer += c.text;
            pushStream(run);
        }, 'background', run.signal);
        const c = res.choices[0];
        if (c)
            run.buffer = c.parsedContent ?? c.text ?? run.buffer;
    }
    catch (e) {
        if (!run.cancelled)
            api.v1.error('Prompt Forge: background generation failed', e);
    }
    finally {
        refreshBudget();
    }
    if (ACTIVE === run)
        ACTIVE = null;
    await finishRun(run);
}
function boundRun(continuityId) {
    return ACTIVE && ACTIVE.continuityId === continuityId ? ACTIVE : null;
}
function pushStream(run, force = false) {
    const now = Date.now();
    if (!force && now - lastStreamPush < 120)
        return;
    lastStreamPush = now;
    setRun({ text: cleanModelText(run.buffer).slice(-1500), status: 'running' });
}
function registerHooks() {
    api.v1.hooks.register('onGenerationRequested', async (p) => {
        if (PENDING) {
            ACTIVE = PENDING;
            PENDING = null;
            ACTIVE.continuityId = p.continuityId;
            setRun({ status: 'running', message: '' });
            return;
        }
        const s = S();
        if (!s.enabled || ACTIVE)
            return;
        if (s.armed) {
            const run = newRun(s.armed.job, s.armed.arg);
            if (typeof run === 'string') {
                toast(run, 'warning');
                return { stopGeneration: true };
            }
            run.continuityId = p.continuityId;
            ACTIVE = run;
            STORE.set(st => ({ ...st, run: { id: run.id, job: run.job, label: run.label, attempt: 1, text: '', status: 'running', message: '', mode: 'editor' }, last: null }));
            return;
        }
        if (s.settings.sendWithNoStep === 'block' && !p.scriptInitiated) {
            toast('Prompt Forge: pick a step in the panel, or arm one so Send runs it.', 'info');
            return { stopGeneration: true };
        }
    });
    api.v1.hooks.register('onBeforeContextBuild', p => {
        const run = boundRun(p.continuityId) || (p.dryRun && S().enabled && S().armed ? true : null);
        if (!run)
            return;
        const off = { active: false, content: '' };
        return {
            storyText: off,
            memory: off,
            authorsNote: off,
            prefill: off,
            systemPrompt: off,
            lorebookEntries: p.lorebookEntries.map(([id]) => [id, { active: false }]),
        };
    });
    api.v1.hooks.register('onContextBuilt', p => {
        const run = boundRun(p.continuityId);
        if (run)
            return { messages: run.messages };
        const s = S();
        if (p.dryRun && s.enabled && s.armed) {
            const preview = newRun(s.armed.job, s.armed.arg);
            if (typeof preview !== 'string')
                return { messages: preview.messages };
        }
    });
    api.v1.hooks.register('onResponse', p => {
        const run = boundRun(p.continuityId);
        if (!run)
            return;
        run.buffer += p.text.join('');
        pushStream(run, p.final);
        const hide = S().settings.output === 'capture';
        const text = hide ? p.text.map(() => '') : p.text;
        if (run.cancelled || run.buffer.length > JOBS[run.job].maxTokens * 8)
            return { stopGeneration: true, text };
        if (hide)
            return { text };
    });
    api.v1.hooks.register('onGenerationEnd', async (p) => {
        const run = boundRun(p.continuityId);
        if (!run)
            return;
        ACTIVE = null;
        await finishRun(run);
    });
}
async function restoreParams(run) {
    if (!run.savedParams)
        return;
    try {
        const { model, ...rest } = run.savedParams;
        await api.v1.generationParameters.update(rest);
    }
    catch {
    }
    run.savedParams = null;
}
async function clearScratch(run) {
    if (run.scratchFrom === null)
        return;
    try {
        const ids = await api.v1.document.sectionIds();
        const at = ids.indexOf(run.scratchFrom);
        if (at >= 0)
            await api.v1.document.removeParagraphs(ids.slice(at));
    }
    catch {
    }
    run.scratchFrom = null;
}
async function finishRun(run) {
    await clearScratch(run);
    if (run.cancelled) {
        await restoreParams(run);
        STORE.set(s => ({ ...s, queue: [], run: s.run && { ...s.run, status: 'cancelled', message: 'Stopped.' } }));
        return;
    }
    setRun({ status: 'parsing', text: cleanModelText(run.buffer).slice(-1500) });
    const s = S();
    const spec = JOBS[run.job];
    let res;
    try {
        res = spec.parse(run.buffer, s.setup, s.lib, run.arg, run.allowed);
    }
    catch (e) {
        api.v1.error('Prompt Forge: parse failed', e);
        res = { preview: run.buffer, problems: ['The answer could not be read.'], retry: 'Answer in exactly the format shown.' };
    }
    if (res.retry && run.attempt <= s.settings.retries) {
        run.messages = retryMessages(run.base, run.buffer, res.retry);
        run.attempt++;
        run.buffer = '';
        run.continuityId = null;
        setRun({ status: 'starting', attempt: run.attempt, text: '', message: `Retrying: ${res.retry.slice(0, 160)}` });
        await dispatch(run);
        return;
    }
    await restoreParams(run);
    const usable = !!(res.applySetup || res.applySheet);
    const failed = !usable;
    if (usable && s.settings.autoApply)
        applyResult(res, run);
    STORE.set(st => ({
        ...st,
        run: st.run && { ...st.run, status: failed ? 'failed' : 'done', message: failed ? res.retry || 'No usable answer.' : '' },
        last: {
            runId: run.id,
            job: run.job,
            label: run.label,
            arg: run.arg,
            preview: res.preview,
            problems: res.retry && usable ? [...res.problems] : res.problems,
            raw: run.buffer,
