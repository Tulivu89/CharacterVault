                    ex.output.slice(0, 80),
                    ex.output.length > 80 ? '…' : ''),
                h(Btn, { kind: "danger", onClick: () => deleteExample(ex) }, "\u2715"))))),
        h(Panel, { title: `Style blocks (${s.lib.styles.length})`, startOpen: false }, s.lib.styles.map(b => (h("div", { style: st.col },
            h("span", null,
                h("strong", null, b.name),
                " ",
                h("span", { style: st.hint },
                    b.entryId ? '· Lorebook' : '· built-in',
                    " ",
                    b.note)))))),
        h(Panel, { title: `Kits (${s.lib.kits.length})`, startOpen: false }, s.lib.kits.map(k => (h("span", null,
            k.name,
            " ",
            h("span", { style: st.hint }, k.entryId ? '· Lorebook' : '· built-in')))))));
}
function SettingsTab(p) {
    const { s } = p;
    const set = s.settings;
    return (h("div", { style: st.col },
        h("div", { style: { ...st.card, ...st.col } },
            h(Check, { checked: s.enabled, onChange: v => patch({ enabled: v }), label: "This story is a Prompt Forge workspace", title: "Off: the script only acts on steps you start from the panel" }),
            h("div", { style: st.grid2 },
                h(Field, { label: "Run steps through", hint: "Send isn't drawn from the script token budget; background is, and falls back to Send when low" },
                    h(Pick, { value: set.mode, options: [['editor', 'Send (editor generation)'], ['background', 'Background (script budget)']], onChange: v => setSettings({ mode: v }) })),
                h(Field, { label: "Model reply", hint: "Scratch: if hidden capture misbehaves, replies stream into a paragraph that's removed after" },
                    h(Pick, { value: set.output, options: [['capture', 'Hidden (captured by the script)'], ['scratch', 'Scratch paragraph']], onChange: v => setSettings({ output: v }) })),
                h(Field, { label: "Send with no step armed" },
                    h(Pick, { value: set.sendWithNoStep, options: [['block', 'Do nothing (toast)'], ['normal', 'Generate normally']], onChange: v => setSettings({ sendWithNoStep: v }) })),
                h(Field, { label: "Retries on a bad answer" },
                    h(NumIn, { value: set.retries, min: 0, max: 3, onChange: v => setSettings({ retries: clamp(Math.round(v), 0, 3) }) }))),
            h("div", { style: st.row },
                h(Check, { checked: set.autoApply, onChange: v => setSettings({ autoApply: v }), label: "Apply answers automatically (Undo is always there)" }),
                h(Check, { checked: set.liveDoc, onChange: v => setSettings({ liveDoc: v }), label: "Rewrite the document blocks after each step" }))),
        h(Panel, { title: "Hidden from menus", startOpen: false },
            h("span", { style: st.hint }, "Tags the model is never offered (one per line; * is a wildcard). Typing them yourself still works."),
            h(Area, { value: set.hide.join('\n'), rows: 4, onChange: v => setSettings({ hide: v.split('\n').map(t => t.trim()).filter(Boolean) }) }),
            h("div", { style: st.row },
                h(Btn, { onClick: () => setSettings({ hide: uniq([...set.hide, ...vocab().menuHide]) }) }, "Add Waifoundry's default hidden list"))),
        h(Panel, { title: "Script budget (background mode only)", startOpen: false, right: h(Btn, { onClick: refreshBudget }, "Refresh") }, s.budget ? (h("span", null,
            "Input ",
            s.budget.input,
            " \u00B7 output ",
            s.budget.output,
            " tokens available now. It refills over time while you use the script.")) : (h("span", { style: st.hint }, "Press Refresh."))),
        h("div", { style: st.row },
            h(Btn, { kind: "danger", onClick: () => {
                    clearDocument().then(ok => {
                        if (ok)
                            toast('Document cleared.', 'success');
                    });
                }, title: "Removes every paragraph in this story, including archived setups" }, "Clear the document")),
        h("span", { style: st.hint },
            "Vocab: ",
            vocab().source,
            " \u00B7 ",
            VOCAB_DATA.artists.split('|').length,
            " artists for count checks.")));
}
let forgeWindow = null;
function forgeRoot(id) {
    return api.v1.ui.part.jsx({
        id,
        onMount: (el) => render(h(App, null), el),
        captureEvents: ['keydown', 'keyup', 'keypress'],
    });
}
async function openForgeWindow() {
    if (forgeWindow && !forgeWindow.isClosed())
        return;
    forgeWindow = await api.v1.ui.window.open({
        id: 'forge-window',
        title: 'Prompt Forge',
        defaultWidth: 760,
        defaultHeight: '80%',
        minWidth: 420,
        resizable: true,
        content: [forgeRoot('forge-root-window')],
    });
}
registerHooks();
(async () => {
    try {
        await loadState();
        await api.v1.ui.register([
            api.v1.ui.extension.scriptPanel({ id: 'forge-panel', name: 'Prompt Forge', iconId: 'image', content: [forgeRoot('forge-root-panel')] }),
            api.v1.ui.extension.toolbarButton({ id: 'forge-open', text: 'Forge', iconId: 'image', callback: () => openForgeWindow() }),
        ]);
        await loadLibrary();
        refreshBudget();
        await firstRun();
    }
    catch (e) {
        api.v1.error('Prompt Forge failed to start', e);
    }
})();
