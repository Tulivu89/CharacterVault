    if (words.includes('camera'))
        issue(ctx, 'warn', where, 'Say "viewer", not "camera" (a literal camera can appear).');
    if (/["“”]/.test(text) && !ctx.setup.text)
        issue(ctx, 'warn', where, 'Quotation marks mean rendered text; remove them or turn on "Text in image".');
    const sentences = text.split(/[.!?]+(\s|$)/).filter(s => s.trim()).length;
    if (sentences > 6)
        issue(ctx, 'warn', where, `${sentences} sentences; past the token ceiling the tail (style, rating) is ignored. Aim for 2–5.`);
    if (/\b(in front of|behind)\b/i.test(text))
