                h(PosGrid, { value: c.position, onChange: v => ed(m => (m.position = v)) }),
                h("span", { style: st.hint }, c.position ? positionGloss(c.position.x, c.position.y) : 'auto')),
            h(Check, { checked: c.noTrim, onChange: v => ed(m => (m.noTrim = v)), label: "No framing trims" })),
        !sheet && !Object.values(c.look).some(Boolean) ? (h("span", { style: st.hint },
