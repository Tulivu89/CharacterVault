        h(Panel, { title: `Saved setups (${saved.length})`, startOpen: false, right: h(Btn, { onClick: () => patch({ setup: blankSetup(), last: null, run: null }) }, "New setup") }, saved.map(x => (h("div", { style: { ...st.row, justifyContent: 'space-between' } },
            h("span", null, x.title),
            h("span", { style: st.row },
                h(Btn, { onClick: () => STORE.set(st0 => ({ ...st0, setup: clone(x), undo: [...st0.undo, { label: 'Load setup', setup: st0.setup }] })) }, "Load"),
                h(Btn, { onClick: () => STORE.set(st0 => ({ ...st0, setup: { ...clone(x), id: shortId(), title: `${x.title} (copy)` } })) }, "Copy"),
                h(Btn, { kind: "danger", onClick: () => STORE.set(st0 => {
