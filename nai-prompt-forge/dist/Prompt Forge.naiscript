}
function nextInQueue() {
    const q = S().queue;
    if (!q.length)
        return;
    let [next, ...rest] = q;
    if (next.job === 'pose' && next.arg.castId === '*') {
        const poses = S().setup.cast.map(c => ({ job: 'pose', arg: { castId: c.id } }));
        if (!poses.length) {
            patch({ queue: rest });
            return nextInQueue();
