}
function para(text, bold = false) {
    return { text, formatting: bold && text ? [{ position: 0, length: text.length, data: 'bold' }] : [] };
}
function blockParas(b, title, stamp = '') {
    const out = [para(`▌ ${title}${stamp ? ` · ${stamp}` : ''}`, true), para('Model & Settings', true), ...lines(b.settings).map(l => para(l)), para(''), para('Base Prompt', true), para(b.base), para(''), para('Base UC', true), para(b.baseUc)];
    b.chars.forEach((c, i) => {
        out.push(para(''), para(c.title, true), ...lines(c.prompt).map(l => para(l)), para(''), para(`Character ${i + 1} UC`, true), para(c.uc || '-'));
    });
    if (b.notes.length)
        out.push(para(''), para('Notes', true), ...b.notes.map(n => para(`• ${n}`)));
    out.push(para(''));
