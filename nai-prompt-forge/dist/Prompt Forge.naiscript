const PREAMBLE = 'You fill in one part of an image prompt for an anime image model (NovelAI Diffusion V5). Do only the task below. ' +
    'Answer in exactly the format shown: no greeting, no explanation, no notes, no markdown.';
function fieldsOf(text, keys) {
    const out = {};
    let last = '';
    for (const raw of cleanModelText(text).split('\n')) {
        const line = raw.replace(/\*\*/g, '').replace(/^[\s>*\-•]+/, '').trim();
        if (!line)
            continue;
        const m = line.match(/^([A-Za-z][A-Za-z /]{0,24}?)\s*[:：]\s*(.*)$/);
        const key = m ? m[1].trim().toUpperCase() : '';
        if (m && keys.includes(key)) {
            out[key] = out[key] ? out[key] + '\n' + m[2].trim() : m[2].trim();
            last = key;
        }
        else if (last && !m) {
            out[last] += ' ' + line;
        }
    }
    return out;
}
function isNone(v) {
    return !v || /^(-|none|n\/a|nothing|no)\.?$/i.test(v.trim());
}
function tagList(v) {
    if (isNone(v))
        return [];
    return uniq(String(v)
        .split(/[,;\n]/)
        .map(t => t.replace(/["'`]/g, '').replace(/\.$/, '').trim())
        .filter(t => t && !isNone(t))
        .map(t => {
        let x = normTag(t);
        if (RENAMED[x])
            x = RENAMED[x];
        const V = vocab();
        if (!V.has(x) && V.aliases.has(x))
            x = V.canon(x);
        return x;
    }));
}
function sortPicks(tags, allowed) {
    const V = vocab();
    const keep = [];
    const offMenu = [];
    const rejected = [];
    for (const t of tags) {
        if (allowed.has(t))
            keep.push(t);
        else if (V.has(t) || OFF_FILE_ALLOWED.has(t)) {
            keep.push(t);
            offMenu.push(t);
        }
        else
            rejected.push(t);
    }
    return { keep, offMenu, rejected };
}
function onePerGroup(tags) {
    const keep = [];
    const dropped = [];
    const used = new Set();
    for (const t of tags) {
        const g = EXCLUSIVE_GROUPS.find(x => x.tags.includes(t));
        if (g && used.has(g.name)) {
            dropped.push(t);
            continue;
        }
        if (g)
            used.add(g.name);
        keep.push(t);
    }
    return { keep, dropped };
}
function sideOf(c, i, n) {
    const x = c.position?.x ?? (n === 1 ? 0.5 : 0.2 + (0.6 * i) / Math.max(1, n - 1));
    return x < 0.4 ? 'on the left' : x > 0.6 ? 'on the right' : 'in the center';
}
function castLines(setup, withState = false) {
    const n = setup.cast.length;
    return setup.cast
        .map((c, i) => {
        const parts = [`${i + 1}. ${c.gender}: ${c.label || c.gender}`];
        if (n > 1)
            parts.push(sideOf(c, i, n));
        if (c.mood)
            parts.push(`mood: ${c.mood}`);
        if (withState) {
