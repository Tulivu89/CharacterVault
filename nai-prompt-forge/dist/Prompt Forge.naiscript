function splitSegments(text) {
    const out = [];
    let buf = '';
    let inWeight = false;
    let inRand = false;
    for (let i = 0; i < text.length; i++) {
        const two = text.slice(i, i + 2);
        if (two === '||') {
            inRand = !inRand;
            buf += two;
            i++;
            continue;
        }
        if (two === '::') {
            const head = buf.trim();
            if (!inWeight && /(^|[\s,])-?\d*\.?\d+$/.test(head))
                inWeight = true;
            else if (inWeight)
                inWeight = false;
            buf += two;
            i++;
            continue;
        }
        const ch = text[i];
        if ((ch === ',' || ch === '\n') && !inWeight && !inRand) {
            if (buf.trim())
                out.push(buf.trim());
            buf = '';
            continue;
        }
        buf += ch;
    }
    if (buf.trim())
        out.push(buf.trim());
    return out;
}
function isProse(seg) {
    const s = seg.trim();
    if (!s)
        return false;
    if (/^-?\d*\.?\d+::/.test(s))
        return false;
    if (/^(artist|character|copyright|species|rating|year|meta):/i.test(s))
        return false;
    if (/^[A-Z]/.test(s) && /\s/.test(s))
        return true;
    return /[a-z]\.\s+[A-Za-z]/.test(s) || /[a-z]\.$/.test(s) && s.split(/\s+/).length > 3;
}
function splitLine(line) {
