                            setKit('');
                        } }, "Apply kit")) : null),
                h("div", { style: st.grid2 }, LOOK_SLOTS.map(sl => (h(Field, { label: sl.label, hint: sl.hint },
                    h(Area, { value: sheet.look[sl.key] || '', rows: 1, onChange: v => ed(x => (x.look[sl.key] = v)) })))))),
            h(Panel, { title: "Outfits" },
