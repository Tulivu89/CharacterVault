        if (prose.length) {
            prose.push(s);
            continue;
        }
        const m = !/::/.test(s) && s.match(/^([^.]+)\.\s+([A-Z][\s\S]*)$/);
        if (m && !isProse(m[1])) {
            tags.push(m[1].trim());
