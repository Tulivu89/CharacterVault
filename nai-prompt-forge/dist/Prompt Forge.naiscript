const st = {
    app: { display: 'flex', flexDirection: 'column', gap: '8px', padding: '8px', color: C.text, fontSize: '13px', lineHeight: '1.4', boxSizing: 'border-box', width: '100%' },
    row: { display: 'flex', gap: '6px', alignItems: 'center', flexWrap: 'wrap' },
