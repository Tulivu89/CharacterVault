    };
    return (h("div", { style: { ...st.card, background: C.bg2 } },
        h("div", { style: { ...st.row, justifyContent: 'space-between' } },
            h("strong", null,
                i + 1,
                ". ",
                c.name || c.label || c.gender),
            h("span", { style: st.row },
                h(StepBtn, { job: "pose", arg: { castId: c.id }, label: "Pick pose", s: s }),
                h(Btn, { disabled: i === 0, onClick: () => editSetup(d => d.cast.splice(i - 1, 0, d.cast.splice(i, 1)[0])) }, "\u2191"),
                h(Btn, { kind: "danger", onClick: () => editSetup(d => ((d.cast = d.cast.filter(y => y.id !== c.id)), (d.interactions = d.interactions.filter(it => it.actor !== c.id && it.target !== c.id))), 'Remove character') }, "\u2715"))),
        h("div", { style: { ...st.grid2, marginTop: '6px' } },
            h(Field, { label: "Saved look" },
                h(Pick, { value: c.sheetId || '', options: [['', 'none'], ...s.lib.sheets.map(sh => [sh.id, sh.name])], onChange: loadSheet })),
            h(Field, { label: "Label in prose", hint: "One visible feature, never a name" },
                h(TextIn, { value: c.label, onChange: v => ed(m => (m.label = v)) })),
            h(Field, { label: "Box starts with" },
                h(Pick, { value: c.gender, options: ['girl', 'boy', 'other'], onChange: v => ed(m => (m.gender = v)) })),
            sheet && sheet.outfits.length > 1 ? (h(Field, { label: "Outfit" },
                h(Pick, { value: c.outfitName, options: sheet.outfits.map(o => [o.name, o.name]), onChange: setOutfit }))) : null,
            h(Field, { label: "Mood", hint: moodCues(c.mood) ? `→ ${moodCues(c.mood)}` : 'grief, shame, defiant, aroused, smug, playful…' },
                h(TextIn, { value: c.mood, onChange: v => ed(m => (m.mood = v)) })),
            h(Field, { label: "Posture" },
                h(TextIn, { value: c.state.posture, onChange: v => ed(m => (m.state.posture = v)) })),
            h(Field, { label: "Gesture" },
                h(TextIn, { value: c.state.gesture, onChange: v => ed(m => (m.state.gesture = v)) })),
            h(Field, { label: "Expression" },
                h(TextIn, { value: c.state.expression, onChange: v => ed(m => (m.state.expression = v)) })),
            h(Field, { label: "Gaze" },
                h(TextIn, { value: c.state.gaze, onChange: v => ed(m => (m.state.gaze = v)) })),
            h(Field, { label: "Other state tags" },
                h(TextIn, { value: c.state.extra, onChange: v => ed(m => (m.state.extra = v)) })),
            h(Field, { label: "Extra character UC" },
