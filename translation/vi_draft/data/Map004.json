":0,"parameters":["face_Actor_npc01",2,0,2,"Fukumi Shinta"]},{"code":401,"indent":0,"parameters":["Này Kensei, sao cậu lại cố tình gọi tôi đến phòng câu lạc bộ vậy?"]},{"code":213,"indent":0,"parameters":[2,7,false]},{"code":101,"indent":0,"parameters":["face_Actor_npc01",1,0,2,"Mutsukado Kensei"]},{"code":401,"indent":0,"parameters":["Phó trưởng bộ môn, tôi đã nói bao nhiêu lần rồi là ở đây phải gọi là"]},{"code":401,"indent":0,"parameters":["trưởng bộ môn……Thôi, kệ đi. Dù sao thì, hãy xem cái này."]},{"code":250,"indent":0,"parameters":[{"name":"add_clothing_-_equip_05","volume":90,"pitch":150,"pan":0}]},{"code":231,"indent":0,"parameters":[1,"_icon_window_03",0,0,520,230,100,100,0,0]},{"code":232,"indent":0,"parameters":[1,0,0,0,520,230,100,100,255,0,60,true,0]},{"code":101,"indent":0,"parameters":["face_Actor_npc01",2,0,2,"Fukumi"]},{"code":401,"indent":0,"parameters":["Chẳng lẽ đây là thiết bị lõi của \"Nữ chiến binh Lam Đỏ\" sao!?"]},{"code":401,"indent":0,"parameters":["Nó nổi tiếng với cái phần cắt cao đến mức gần như hở hang đó...!"]},{"code":232,"indent":0,"parameters":[1,0,0,0,520,230,100,100,0,0,20,true,0]},{"code":235,"indent":0,"parameters":[1]},{"code":101,"indent":0,"parameters":["face_Actor_npc01",1,0,2,"Mutsukado"]},{"code":401,"indent":0,"parameters":["Thực ra, hôm qua tôi đã vớt được nó từ một cái kho của chúng tôi, nơi"]},{"code":401,"indent":0,"parameters":["đã bị bỏ quên trong nhiều năm."]},{"code":101,"indent":0,"parameters":["face_Actor_npc01",2,0,2,"Fukumi"]},{"code":401,"indent":0,"parameters":["Tại sao một món đồ hiếm như vậy lại ở trong kho của nhà trưởng phòng"]},{"code":401,"indent":0,"parameters":["chứ...?"]},{"code":101,"indent":0,"parameters":["face_Actor_npc01",1,0,2,"Mutsukado"]},{"code":401,"indent":0,"parameters":["Có lẽ đó là đồ cá nhân của mẹ tôi?"]},{"code":401,"indent":0,"parameters":["Những bức ảnh cosplay thời đó cũng được tìm thấy cùng với nó."]},{"code":101,"indent":0,"parameters":["face_Actor_npc01",2,0,2,"Fukumi"]},{"c